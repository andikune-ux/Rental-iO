<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_kiosk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810"
    tools:context="dev.andikune.rentalio.ui.MainActivity">

    <!-- 1. 3D Parallax Gaming Wallpaper Layer -->
    <ImageView
        android:id="@+id/iv_parallax_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="-40dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/img_gaming_wallpaper" />

    <!-- 2. Clean Ambient Vignette (Transparent Atmosphere) -->
    <View
        android:id="@+id/view_vignette_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D050810" />

    <!-- 3. Main Landscape Layout: Left Side (Toggle Button + Curved Carousel) & Right Side (Compose UI) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Container: Houses the floating toggle button & C-Shape Curved Carousel -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp">

            <!-- Dynamic Radial Gradient Glow Layer behind the carousel (Palette API driven) -->
            <ImageView
                android:id="@+id/iv_panel_radial_glow"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_marginStart="48dp"
                android:alpha="0.80"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <!-- Vertical C-Shape Coverflow Container (Default hidden: alpha 0, invisible) -->
            <FrameLayout
                android:id="@+id/fl_left_carousel_container"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_marginStart="52dp"
                android:alpha="0"
                android:visibility="invisible"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Vertical C-Shape Coverflow RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_app_carousel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

            </FrameLayout>

            <!-- Floating Toggle Button at KIRI TENGAH with Liquid Glass outline & Apps Grid Icon -->
            <FrameLayout
                android:id="@+id/btn_toggle_carousel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_carousel_item_glass"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_toggle_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Daftar Aplikasi"
                    android:src="@drawable/ic_apps_grid" />
            </FrameLayout>

        </FrameLayout>

        <!-- [ PANEL KANAN - ACTION & TIMER + OVERLAYS ] -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_kiosk_ui"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
